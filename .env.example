# Dream More AppWorks — Frontend environment
# Copy this file to `.env` and adjust values for your local setup.

# Base URL of the Laravel REST API (versioned at /api/v1).
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1

# Optional: override the platform display name.
# VITE_APP_NAME=Dream More AppWorks

# Laravel Reverb WebSocket configuration (for real-time messaging).
# Set these when running `php artisan reverb:start` on the backend.
# Leave unset to disable WebSocket and fall back to REST polling.
# VITE_REVERB_APP_KEY=your-reverb-app-key
# VITE_REVERB_HOST=127.0.0.1
# VITE_REVERB_PORT=8080
# VITE_REVERB_SCHEME=http
